# ============ 环境变量示例模板 ============
# 复制本文件为 .env 并填写真实值
# ⚠️ .env 已被 .gitignore 排除，不会上传到 GitHub

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-minio-secret-key
BUCKET_NAME=rag-files

# 向量数据库
MILVUS_DB_PATH=./milvus-lite-data/milvus.db

# 文档目录
DOC_ROOT_DIR=./docs

# DeepSeek 大模型（生成回答用）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Rerank 重排模型（XInference 本地服务）
RERANK_API_KEY=your-xinference-api-key
RERANK_URL=http://localhost:9997/v1/rerank
RERANK_MODEL=bge-reranker-v2-m3
